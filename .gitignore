# Game images and anything extracted from them are never committed.
*.tap
*.TAP
*.t64
*.d64
*.g64
*.prg
*.adf
*.ADF
*.dms
*.ipf
/.analysis
/build/
.DS_Store

# Local source images, never bundled or committed.
/images/
*.ipa
*.nds
*.3ds
*.cia
*.cci

# Imported engines keep local research links and standalone build directories.
/games/*/.analysis
/games/*/build*/
/games/*/.cache/

# Android outputs, downloaded tool dependencies and signing material.
/build-android/
*.keystore
*.jks
